# ---------------------------------------------------------------------------
# CreatorSphere AI — environment variables
# Copy this file to `.env.local` and fill in real values. NEVER commit secrets.
# ---------------------------------------------------------------------------

# Supabase project URL and public (publishable / anon) key — safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role key. Used by seed scripts and privileged
# admin operations. NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key — server-only. Used by AI routes (/api/ai/*).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Business rule: restrict registration to Gmail addresses only ("true" / "false").
NEXT_PUBLIC_ALLOW_GMAIL_ONLY=false

# Optional: company verification provider keys (see lib/verification/*).
# RDAP requires no key. Optional paid business-data providers can go here.
COMPANY_VERIFY_PROVIDER=rdap

# Public site URL used for auth redirects (set to your Vercel URL in production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
